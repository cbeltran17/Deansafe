<div
  class="block-column block-spacing"
  id="shopify-block-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.media_type == 'image' and block.settings.image != blank %}
    <div class="block-image">
      {% render 'image' with block.settings.image,
        width: 1600,
        widths: '400, 800, 1200, 1600',
        placeholder: true
      %}
    </div>
  {% elsif block.settings.media_type == 'video' and block.settings.video != blank %}
    <div class="block-video w-full">
      {% if block.settings.video_autoplay %}
        {% render 'video' with block.settings.video, autoplay: true, controls: false, loop: true %}
      {% else %}
        {% render 'video' with block.settings.video, controls: true %}
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <div class="block-heading">{% render 'heading', block: block %}</div>
  {% endif %}

  {% if block.settings.content != blank %}
    <div class="block-paragraph paragraph prose">
      {{ block.settings.content }}
    </div>
  {% endif %}

  {% if block.settings.link_url != blank and block.settings.link_text != blank %}
    <div class="block-button">
      {% if block.settings.link_style == 'button' %}
        {% render 'button' with block.settings.link_text, href: block.settings.link_url %}
      {% else %}
        <a
          class="text-alpha-800 underline underline-offset-4 hover:text-alpha-900"
          href="{{ block.settings.link_url }}"
        >
          {{- block.settings.link_text -}}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:blocks._column.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:blocks._column.settings.media_type.label",
      "options": [
        {
          "value": "image",
          "label": "t:blocks._column.settings.media_type.options.image.label"
        },
        {
          "value": "video",
          "label": "t:blocks._column.settings.media_type.options.video.label"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks._column.settings.image.label",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:blocks._column.settings.video.label",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:blocks._column.settings.video_autoplay.label",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options.3x-large"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options.2x-large"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options.x-large"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options.large"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options.medium"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options.small"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options.x-small"
        }
      ],
      "default": "h4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks._column.settings.heading.label",
      "default": "t:blocks._column.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:blocks._column.settings.content.label",
      "default": "t:blocks._column.settings.content.default"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:blocks._column.settings.link_url.label"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:blocks._column.settings.link_text.label"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "t:blocks._column.settings.link_style.label",
      "options": [
        {
          "value": "button",
          "label": "t:blocks._column.settings.link_style.options.button.label"
        },
        {
          "value": "link",
          "label": "t:blocks._column.settings.link_style.options.link.label"
        }
      ],
      "default": "button"
    }
  ],
  "presets": [
    {
      "name": "t:blocks._column.name"
    }
  ]
}
{% endschema %}
