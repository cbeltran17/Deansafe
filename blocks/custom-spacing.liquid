{% render 'custom-spacing', block: block %}

{% schema %}
{
  "name": "t:blocks.custom_spacing.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "spacing",
      "label": "t:blocks.custom_spacing.settings.spacing.label",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "use_different_value_on_mobile",
      "label": "t:blocks.custom_spacing.settings.use_different_value_on_mobile.label",
      "default": false
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "label": "t:blocks.custom_spacing.settings.spacing_mobile.label",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 32,
      "unit": "px",
      "visible_if": "{{ block.settings.use_different_value_on_mobile == true }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.custom_spacing.name"
    }
  ]
}
{% endschema %}
