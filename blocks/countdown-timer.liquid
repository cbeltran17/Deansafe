{% liquid
  assign timezone_offset = 'now' | date: '%:z'
  capture expires_iso
    echo block.settings.year
    echo '-'
    echo block.settings.month
    echo '-'
    echo block.settings.day
    echo 'T'
    echo block.settings.hour
    echo ':'
    echo block.settings.minute
    echo ':00'
    echo timezone_offset
  endcapture
  assign countdown_font_class = 'countdown--font-' | append: block.settings.font
  assign countdown_size_class = 'countdown--size-' | append: block.settings.text_size
%}

<style>
  #shopify-block-{{ block.id }} .countdown {
    {% render 'color-var' with block.settings.text_color, name: 'countdown-value-color' %}
    {% render 'color-var' with block.settings.separator_color, name: 'countdown-separator-color' %}
  }
</style>

<countdown-timer
  class="countdown {{ countdown_font_class }} {{ countdown_size_class }}"
  expires="{{ expires_iso }}"
  {% if block.settings.finish_message != blank %}
    finish-message="{{ block.settings.finish_message | escape }}"
  {% endif %}
  days-label="{{ 'sections.countdown.days' | t | escape }}"
  hours-label="{{ 'sections.countdown.hours' | t | escape }}"
  minutes-label="{{ 'sections.countdown.minutes' | t | escape }}"
  seconds-label="{{ 'sections.countdown.seconds' | t | escape }}"
></countdown-timer>

