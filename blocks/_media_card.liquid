{% liquid
  assign index = section.blocks | find_index: 'id', block.id | plus: 1
  assign layout = section.settings.layout
  assign count = section.blocks.size
%}

<div
  id="shopify-block-{{ block.id }}"
  {{ block.shopify_attributes }}
  class="
    block-media-card
    media-with-overlay
    media-with-overlay--{{ block.settings.content_position }}
    {% if block.settings.content_position_mobile %}
      media-with-overlay--mobile-{{ block.settings.content_position_mobile }}
    {% endif %}
    media-with-overlay--absolute
  "
>
  {% render 'image-size-vars',
    target: block,
    prefix: '--media-with-overlay',
    breakpoint: 1024,
    placeholder_ratio: '16/9'
  %}

  <style>
    #shopify-block-{{ block.id }} {
      {% render 'base-color-vars' with block %}
      --media-overlay-opacity: {{ block.settings.overlay_opacity }}%;
      --media-overlay-color: {{ block.settings.overlay_color }};
    }
  </style>

  {% capture sizes %}{% render 'media-card-sizes', index: index, count: count, layout: layout %}{% endcapture %}
  {% render 'image' with block.settings.image,
    image_mobile: block.settings.image_mobile,
    class: 'media-with-overlay__media',
    sizes: sizes,
    width: 3200,
    widths: '400, 600, 800, 1000, 1200, 1400, 1600, 2000, 2400, 3200',
    placeholder: 'lifestyle-1',
    placeholder_class: 'placeholder--dark',
    animation: 'zoom-out'
  %}
  <div class="media-with-overlay__overlay">
    <div class="media-with-overlay__content block-spacing block-spacing--media-card">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

