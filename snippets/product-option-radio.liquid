{% liquid
  assign type = type | default: 'radio'

  assign downcased_option_name = option.name | downcase
  assign selected_extra_price = ""

  if downcased_option_name == 'color'
    for option_value in option.values
      if option_value.selected and option_value.variant
        if option_value.variant.price > product.price
          assign price_diff = option_value.variant.price | minus: product.price
          assign formatted_diff = price_diff | money_without_trailing_zeros
          assign selected_extra_price = " + " | append: formatted_diff
        endif
      endif
    endfor
  endif
%}

<fieldset data-product-option>
  <div class="product-option-label">
    <legend class="contents">
      <span class="product-option-name">{{ option.name }}{% if product.tags contains "Show Exterior Interior" %} (Exterior/Interior){% endif %}:</span>
      <span class="product-option-value">{{ option.selected_value }}{{ selected_extra_price }}</span>
    </legend>
    {% render 'product-size-chart', option: option, block: block %}
  </div>
  <div class="option-radio-container">
    {% for option_value in option.values %}
      {% liquid
        if hide_sold_out_variants and option_value.available == false and option_value.selected == false
          continue
        endif
      %}

      {% if type == 'image' %}
        {% render 'option-value-image',
          option: option,
          option_value: option_value,
          id: id,
          index: forloop.index
        %}
      {% elsif type == 'swatch' %}
        {% render 'option-value-swatch',
          option: option,
          option_value: option_value,
          id: id,
          index: forloop.index
        %}
      {% else %}
        {% render 'option-value-radio',
          option: option,
          option_value: option_value,
          id: id,
          index: forloop.index
        %}
      {% endif %}
    {% endfor %}
  </div>
</fieldset>
