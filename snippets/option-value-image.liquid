{% liquid
  assign image = option_value.variant.image

  if option_value.product_url != blank and image == blank
    assign image = option_value.variant.product.featured_image
  endif
%}

{% if image %}
  <div
    class="option-value-image"
    {% if option_value.available == false %}
      data-unavailable
    {% endif %}
  >
    <input
      type="radio"
      id="{{ id }}-{{ index }}"
      name="{{ id }}[{{ option.name | escape }}]"
      value="{{ option_value | escape }}"
      data-product-url="{{ option_value.product_url }}"
      data-variant-id="{{ option_value.variant.id }}"
      data-option-value-id="{{ option_value.id }}"
      {% if option_value.selected %}
        checked
      {% endif %}
    >
    <label for="{{ id }}-{{ index }}">
      {% render 'image' with image, width: 128 %}
    </label>
  </div>
{% else %}
  {% render 'option-value-radio',
    option: option,
    option_value: option_value,
    id: id,
    index: index
  %}
{% endif %}
