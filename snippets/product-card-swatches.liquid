{%- capture id -%}
  {{ section.id }}-{{ product.id }}-card-swatches
{%- endcapture -%}

{%- capture content -%}
  {% assign rendered_count = 0 %}
  {% assign total_swatch_count = 0 %}
  {% assign swatch_limit = limit | default: 0 %}
  {% for option in product.options_with_values %}
    {% for option_value in option.values %}
      {% liquid
        capture legacy_swatch
          render 'get-legacy-color-swatch', option_name: option.name, option_value_name: option_value.name
        endcapture
      %}
      {% if option_value.variant.featured_media and option_value.swatch or legacy_swatch != blank %}
        {% liquid
          assign has_swatch = true
          assign total_swatch_count = total_swatch_count | plus: 1

          if swatch_limit > 0 and rendered_count >= swatch_limit
            continue
          endif

          assign variant_url = option_value.variant.url

          if section.settings.include_collection_url and collection
            assign variant_url = variant_url | within: collection
          endif
        %}
        {%- capture attrs -%}
          data-product-card-url="{{ variant_url }}"
        {%- endcapture -%}
        {% render 'option-value-swatch',
          option: option,
          option_value: option_value,
          id: id,
          index: rendered_count,
          checked: false,
          attrs: attrs
        %}
        {% assign rendered_count = rendered_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if has_swatch %}
      {% break %}
    {% endif %}
  {% endfor %}
{%- endcapture -%}

{% if content != blank %}
  <div class="product-card__swatches">
    {{ content }}
    {% if swatch_limit > 0 and total_swatch_count > swatch_limit %}
      {% assign remaining_count = total_swatch_count | minus: swatch_limit %}
      <span class="product-card__swatches-more">+{{ remaining_count }}</span>
    {% endif %}
  </div>
{% endif %}
