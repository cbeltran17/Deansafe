{% comment %}
  Renders a social sharing button
  Accepts:
  - share_title: {String} Title to share
  - share_permalink: {String} URL to share
  - share_image: {Object} Image object to share (optional)
{% endcomment %}

{%- liquid
  assign share_url = request.origin | append: share_permalink
  assign encoded_url = share_url | url_encode
  assign encoded_title = share_title | url_encode
-%}

<share-button
  class="share-button"
  share-url="{{ share_url | escape }}"
  share-title="{{ share_title | escape }}"
>
  <div data-part="reference">
    {%- capture content -%}
      {{ 'icon-ui-share.svg' | inline_asset_content }}
      <span>{{ 'general.social.share_button' | t }}</span>
    {%- endcapture -%}
    {% render 'button' with content, variant: 'outline-light', size: 'sm' %}
  </div>

  <div class="listbox__popover listbox__popover--hover" hidden>
    <a
      href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
      class="listbox__item"
      target="_blank"
      rel="noopener"
      aria-label="{{ 'general.social.share_on_facebook' | t }}"
    >
      {{ 'icon-facebook.svg' | inline_asset_content }}
      <span>{{ 'general.social.links.facebook' | t }}</span>
    </a>
    <a
      href="https://twitter.com/intent/tweet?text={{ encoded_title }}&url={{ encoded_url }}"
      class="listbox__item"
      target="_blank"
      rel="noopener"
      aria-label="{{ 'general.social.share_on_twitter' | t }}"
    >
      {{ 'icon-twitter.svg' | inline_asset_content }}
      <span>{{ 'general.social.links.twitter' | t }}</span>
    </a>
    <a
      href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ encoded_title }}{% if share_image %}&media={{ share_image | image_url: width: 1024 }}{% endif %}"
      class="listbox__item"
      target="_blank"
      rel="noopener"
      aria-label="{{ 'general.social.share_on_pinterest' | t }}"
    >
      {{ 'icon-pinterest.svg' | inline_asset_content }}
      <span>{{ 'general.social.links.pinterest' | t }}</span>
    </a>
    <button
      type="button"
      class="listbox__item"
      data-copy-url="{{ share_url }}"
      aria-label="{{ 'general.social.copy_to_clipboard' | t }}"
    >
      {{ 'icon-ui-clipboard.svg' | inline_asset_content }}
      <span>{{ 'general.social.copy_link' | t }}</span>
    </button>
  </div>
</share-button>
