{% liquid
  assign id = 'header-navigation-item-' | append: link_position
%}

<navigation-dropdown
  class="header__navigation-dropdown-reference"
  trigger="hover"
  backdrop="header"
  cross-offset="-12"
>
  <a
    href="{{ link.url }}"
    slot="button"
    class="header__navigation-item {% if link.child_active %} active {% endif %}"
  >
    <menu-item-label class="item-label">
      {{ link.title | escape }}
    </menu-item-label>
    <span aria-hidden="true" class="item-label item-label--duplicate">
      {{ link.title | escape }}
    </span>
  </a>

  <ul class="header-submenu">
    {%- for childlink in link.links -%}
      <li>
        {% if childlink.links != blank %}
          <smooth-collapse
            class="header-submenu__collapse"
            data-part="animation-item"
            group="{{ id }}"
          >
            <button
              slot="summary"
              class="header-submenu__collapse-toggle icon-flip-y"
            >
              <span>{{ childlink.title | escape }}</span>
              {{ 'icon-chevron-down.svg' | inline_asset_content }}
            </button>
            <div class="header-submenu__collapse-panel">
              <ul class="header-submenu__colapse-list">
                {% if childlink.url != '#' %}
                  <li>
                    <a
                      href="{{ childlink.url }}"
                      class="header-submenu__collapse-link"
                      {% if childlink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span class="link-inner">{{ childlink.title | escape }}</span>
                    </a>
                  </li>
                {% endif %}
                {%- for sublink in childlink.links -%}
                  <li>
                    <a
                      href="{{ sublink.url }}"
                      class="header-submenu__collapse-link"
                      {% if sublink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span class="link-inner">{{ sublink.title | escape }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </smooth-collapse>
        {% else %}
          <a
            data-part="animation-item"
            href="{{ childlink.url }}"
            class="header-submenu__link"
            {% if childlink.current %}
              aria-current="page"
            {% endif %}
          >
            <span class="link-inner">{{ childlink.title | escape }}</span>
          </a>
        {% endif %}
      </li>
    {%- endfor -%}
  </ul>
</navigation-dropdown>
