{% capture content %}
  {% if link_text != blank %}
    {{ link_text }}
  {% else %}
    {{ 'sections.featured_collection.view_all' | t }}
  {% endif %}
  <svg class="-mr-1" width="16" height="16" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M9.83333 4.60016L8.9 5.56683L11.2667 7.93349H3.16667V9.26683H11.2667L8.9 11.6335L9.83333 12.6002L13.8333 8.60016L9.83333 4.60016Z" fill="#1F1E1E"/>
  </svg>
{% endcapture %}
<animation-element autoplay>
  {% render 'button' with content,
    href: link_url,
    variant: 'outline-light',
    size: 'sm',
    class: 'self-center'
  %}
</animation-element>
