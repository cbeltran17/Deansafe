<div
  class="color-swatch"
  style="
    {%- if filter_value.swatch.image -%}
      --swatch-fill: url({{ filter_value.swatch.image | image_url: width: 128 }});
    {%- elsif filter_value.swatch.color -%}
      --swatch-fill: {{ filter_value.swatch.color }};
    {%- else -%}
      --swatch-fill: {% render 'get-legacy-color-swatch', option_name: filter.label, option_value_name: filter_value.label %}
    {%- endif -%}
  "
>
  <input
    type="checkbox"
    id="{{ id }}-{{ filter_value.value | camelize | escape }}"
    name="{{ filter_value.param_name }}"
    value="{{ filter_value.value }}"
    {% if filter_value.active %}
      checked
    {% endif %}
    {% if filter_value.count == 0 and filter_value.active == false %}
      disabled
    {% endif %}
  >
  <label
    title="{{ filter_value.label }}"
    class="color-swatch__label"
    for="{{ id }}-{{ filter_value.value | camelize | escape }}"
  >
    <span class="sr-only">{{ filter_value.label }}</span>
    {% if filter_value.count == 0 and filter_value.active == false %}
      {% render 'svg-diagonal-line' %}
    {% endif %}
  </label>
</div>
