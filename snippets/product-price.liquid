{% liquid
  assign show_disclaimer = false
  if block.settings.show_taxes_notice
    if cart.taxes_included or shop.shipping_policy.body != blank
      assign show_disclaimer = true
    endif
  endif
%}

<div class="block-product-price" {{ block.shopify_attributes }}>
  <div data-section-ref="price">
    <div class="product-price" role="status">
      {% render 'price', product: product, use_variant: true %}
      {% comment %}
        {% render 'product-badges', product: product, use_variant: true, sold_out: true, sale: true %}
      {% endcomment %}
 
      <span class="product-badge product-badge--sale">
        <svg width="20px" height="20px" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 11C4.44772 11 4 10.5523 4 10C4 9.44772 4.44772 9 5 9H15C15.5523 9 16 9.44772 16 10C16 10.5523 15.5523 11 15 11H5Z" fill="#000000"/>
          <path d="M9 5C9 4.44772 9.44772 4 10 4C10.5523 4 11 4.44772 11 5V15C11 15.5523 10.5523 16 10 16C9.44772 16 9 15.5523 9 15V5Z" fill="#000000"/>
          </svg> FREE SHIPPING</span>

    </div>
    {% if show_disclaimer %}
      <p class="product-tax-disclaimer prose">
        {% if cart.taxes_included %}
          {{ 'products.product.include_taxes' | t }}
        {% endif %}
        {% if shop.shipping_policy.body != blank %}
          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
        {% endif %}
      </p>
    {% endif %}
  </div>
  {% if product != blank %}
    {% form 'product', product %}
      <input
        data-section-ref="installment_variant_id"
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
      >
      {{ form | payment_terms }}
    {% endform %}
  {% endif %}
</div>
