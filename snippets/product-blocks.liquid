{% assign product_form_id = 'ProductForm-' | append: section.id %}

{% for block in section.blocks %}
  {% if location == 'details' and block.settings.show_under_gallery != true %}
    {% continue %}
  {% elsif location == 'info' and block.settings.show_under_gallery == true %}
    {% continue %}
  {% endif %}

  {% case block.type %}
    {% when '@app' %}
      {% render block %}
    {% when 'text' %}
      {% render 'product-text', product: block, block: block %}
    {% when 'vendor' %}
      {% render 'product-vendor', product: product, block: block %}
    {% when 'title' %}
      {% render 'product-title',
        product: product,
        block: block,
        quick_view_modal: quick_view_modal
      %}
    {% when 'price' %}
      {% render 'product-price', product: product, block: block %}
    {% when 'stock' %}
      {% render 'product-stock', product: product, block: block %}
    {% when 'customized_stock' %}

      {% assign has_custom_data = false %}
      {% if product.metafields.custom.product_status != blank or product.metafields.custom.available_colors != blank or product.metafields.custom.shipment_time != blank %}
        {% assign has_custom_data = true %}
      {% endif %}

      {% if has_custom_data and product.tags contains "In Stock Green" %}
        <div class="stock-notification-banner {% if product.tags contains "In Stock Green" %}in-stock-green{% endif %}">
          {% if product.metafields.custom.product_status != blank %}
            <div class="stock-line-1">
              <span class="check-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path
                    d="M6 12l4 4L18 6"
                    fill="none"
                    stroke="#2E6B2E"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>  
              </span> 
              <span class="stock-highlight">{{ product.metafields.custom.product_status | metafield_tag }}</span>
            </div>
          {% endif %}

          {% if product.metafields.custom.available_colors != blank %}
            <ul class="stock-line-2">
              <li>{{ product.metafields.custom.available_colors }}</li>
            </ul>
          {% endif %}

          {% if product.metafields.custom.shipment_time != blank %}
            <div class="stock-line-3">
              {{ product.metafields.custom.shipment_time }}
            </div>
          {% endif %}
        </div>
      {% elsif has_custom_data and product.tags contains "Dropship Yellow" %}
        <div class="stock-notification-banner {% if product.tags contains "Dropship Yellow" %}dropship-yellow{% endif %}">
          {% if product.metafields.custom.product_status != blank %}
            <div class="stock-line-1">
              <span class="check-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                  <path fill="#fbbf24" d="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                </svg> 
              </span> 
              <span class="stock-highlight">{{ product.metafields.custom.product_status }}</span>
            </div>
          {% endif %}

          {% if product.metafields.custom.available_colors != blank %}
            <ul class="stock-line-2">
              <li>{{ product.metafields.custom.available_colors }}</li>
            </ul>
          {% endif %}

          {% if product.metafields.custom.shipment_time != blank %}
            <div class="stock-line-3">
              {{ product.metafields.custom.shipment_time }}
            </div>
          {% endif %}
        </div>
      {% elsif has_custom_data and product.tags contains "Out of Stock" %}
        <div class="stock-notification-banner {% if product.tags contains "Out of Stock" %}out-of-stock{% endif %}">
          {% if product.metafields.custom.product_status != blank %}
            <div class="stock-line-1">
              <span class="check-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="icon-scalable">
                  <path d="M22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12Z" fill="#E53935" style="opacity: 0.15;"></path>
                  <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="#E53935" stroke-linecap="round" style="stroke-width: 1.5px;"></path>
                  <path d="M15 9L9 15M9 9L15 15" stroke="#E53935" stroke-linecap="round" stroke-linejoin="round" style="stroke-width: 1.5px;"></path>
                </svg>
              </span> 
              <span class="stock-highlight">{{ product.metafields.custom.product_status }}</span>
            </div>
          {% endif %}

          {% if product.metafields.custom.available_colors != blank %}
            <ul class="stock-line-2">
              <li>{{ product.metafields.custom.available_colors }}</li>
            </ul>
          {% endif %}

          {% if product.metafields.custom.shipment_time != blank %}
            <div class="stock-line-3">
              {{ product.metafields.custom.shipment_time }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% when 'model_sizes' %}
      {% if product.metafields.custom.model_sizes != blank %}
        {%- assign current_display_name = product.metafields.custom.model_size_name | default: product.title -%}

        <div class="product-model-sizes model-sizes-wrapper">
          <div class="model-sizes-header">
            <span class="model-sizes-title">Model Sizes</span>
            <span class="model-sizes-active-label">{{ current_display_name }}</span>
          </div>

          <div class="model-sizes-grid">
            
            <a href="{{ product.url }}" class="model-size-pill is-active">
              {{ current_display_name }}
            </a>

            {% if product.metafields.custom.model_sizes != blank %}
              {%- assign model_sizes = product.metafields.custom.model_sizes.value -%}
              
              {%- for sibling in model_sizes -%}
                
                {%- if sibling.handle == product.handle -%}
                  {%- continue -%}
                {%- endif -%}
                
                {%- assign sibling_display_name = sibling.metafields.custom.model_size_name | default: sibling.title -%}

                <a href="{{ sibling.url }}" class="model-size-pill">
                  {{ sibling_display_name }}
                </a>
                
              {%- endfor -%}
            {% endif %}
          </div>
        </div>
      {% endif %}

    {% when 'variant_picker' %}
      {% render 'product-variant-picker',
        product: product,
        product_form_id: product_form_id,
        block: block,
        section_ref: 'variant_picker'
      %}
    {% when 'buy_buttons' %}
      {% render 'product-buy-buttons',
        product: product,
        product_form_id: product_form_id,
        block: block
      %}
    {% when 'description' %}
      {% render 'product-description', product: product, block: block %}
    {% when 'rating' %}
      {% render 'product-rating', product: product, block: block %}
    {% when 'pickup_availability' %}
      {% render 'product-pickup-availability', product: product, block: block %}
    {% when 'specifications' %}
      {% render 'product-specifications', product: product, block: block %}
    {% when 'key_features' %}
      {% render 'product-key-features', product: product, block: block %}
    {% when 'product_highlights' %}
      {% render 'product-highlights', product: product, block: block %}
    {% when 'complementary_products' %}
      {% render 'product-complementary-products', product: product, block: block %}
    {% when 'custom_liquid' %}
      <div class="block-custom-liquid" {{ block.shopify_attributes }}>
        {{ block.settings.custom_liquid }}
      </div>
    {% when 'custom_spacing' %}
      {% render 'custom-spacing', block: block %}
    {% when 'view_full_details' %}
      <a
        class="button button--md button--outline-light"
        href="{{ product.selected_variant.url | default: product.url }}"
        data-section-ref="view-full-details"
        {{ block.shopify_attributes }}
      >
        <span class="button__label w-full justify-between">
          <span>{{ 'sections.quick_view_modal.view_full_details' | t }}</span>
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
        </span>
      </a>
    {% when 'collapsible_content' %}
      {% render 'product-collapsible-content', product: product, block: block %}
    {% when 'input_field' %}
      {% render 'product-custom-field',
        block: block,
        product_form_id: product_form_id,
        type: 'input'
      %}
    {% when 'dropdown_field' %}
      {% render 'product-custom-field',
        block: block,
        product_form_id: product_form_id,
        type: 'dropdown'
      %}
  {% endcase %}
{% endfor %}
