{% for option_value in option.values %}
  {% liquid
    if hide_sold_out_variants and option_value.available == false and option_value.selected == false
      continue
    endif
  %}
  <div
    data-value="{{ option_value | escape }}"
    data-product-url="{{ option_value.product_url }}"
    data-variant-id="{{ option_value.variant.id }}"
    data-option-value-id="{{ option_value.id }}"
    data-title="{{ option_value | escape }}"
  >
    {% if block.settings.swatch_selector_style != 'none' %}
      {% render 'listbox-swatch', option: option, option_value: option_value %}
    {% endif %}
    <span>
      {{ option_value }}
      {% if option_value.available == false %}
        <span class="font-normal text-text/50"> ({{ 'products.product.unavailable' | t }}) </span>
      {% endif %}
    </span>
  </div>
{% endfor %}
