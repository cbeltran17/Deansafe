{% liquid
  assign icon_stroke_scale = 1
  case settings.icon_thickness
    when 'thin'
      assign icon_stroke_scale = 0.6667
    when 'regular'
      assign icon_stroke_scale = 1
    when 'bold'
      assign icon_stroke_scale = 1.25
  endcase

  assign product_card_image_object_fit = 'contain'
  if settings.product_card_image_zoom_to_fill
    assign product_card_image_object_fit = 'cover'
  endif

  assign product_card_image_overlay_opacity = 0
  if settings.product_card_image_shade_enable
    assign product_card_image_overlay_opacity = settings.product_card_image_shade_amount
  endif
%}

<style>
  :root {
    {% if settings.product_card_image_size != blank and settings.product_card_image_size != 'original' %}
      --product-card-image-aspect-ratio: {{ settings.product_card_image_size }};
    {% endif %}
    {% if settings.article_card_image_size != blank and settings.article_card_image_size != 'original' %}
      --article-card-image-aspect-ratio: {{ settings.article_card_image_size }};
    {% endif %}
    --product-card-image-object-fit: {{ product_card_image_object_fit }};
    --product-card-image-overlay-opacity: {{ product_card_image_overlay_opacity }}%;

    --button-border-radius: {{ settings.roundness_buttons }}px;
    --block-border-radius: {{ settings.roundness_blocks }}px;
    --block-md-border-radius: {{ settings.roundness_blocks | at_most: 8 }}px;
    --block-sm-border-radius: {{ settings.roundness_blocks | at_most: 6 }}px;
    --block-xs-border-radius: {{ settings.roundness_blocks | at_most: 4 }}px;
    --input-border-radius: {{ settings.roundness_inputs }}px;
    --dropdown-border-radius: {{ settings.roundness_dropdowns }}px;

    --icon-check-circle: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3crect width='24' height='24' fill='none'/%3e%3cg fill='none' stroke='currentColor' stroke-width='1.5'%3e%3ccircle cx='12' cy='12' r='10'/%3e%3cpath stroke-linecap='round' stroke-linejoin='round' d='m8.5 12.5l2 2l5-5'/%3e%3c/g%3e%3c/svg%3e");
    --icon-alert-circle: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3crect width='24' height='24' fill='none'/%3e%3cg fill='none'%3e%3ccircle cx='12' cy='12' r='10' stroke='currentColor' stroke-width='1.5'/%3e%3cpath stroke='currentColor' stroke-linecap='round' stroke-width='1.5' d='M12 7v6'/%3e%3ccircle cx='12' cy='16' r='1' fill='currentColor'/%3e%3c/g%3e%3c/svg%3e");
    --icon-chevron-down: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='black' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
    --icon-quote: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='1.92 4.02 20.12 15.02'%3E%3Cpath fill='currentColor' d='M6.5 10c-.223 0-.437.034-.65.065c.069-.232.14-.468.254-.68c.114-.308.292-.575.469-.844c.148-.291.409-.488.601-.737c.201-.242.475-.403.692-.604c.213-.21.492-.315.714-.463c.232-.133.434-.28.65-.35l.539-.222l.474-.197l-.485-1.938l-.597.144c-.191.048-.424.104-.689.171c-.271.05-.56.187-.882.312c-.318.142-.686.238-1.028.466c-.344.218-.741.4-1.091.692c-.339.301-.748.562-1.05.945c-.33.358-.656.734-.909 1.162c-.293.408-.492.856-.702 1.299c-.19.443-.343.896-.468 1.336c-.237.882-.343 1.72-.384 2.437c-.034.718-.014 1.315.028 1.747c.015.204.043.402.063.539l.025.168l.026-.006A4.5 4.5 0 1 0 6.5 10m11 0c-.223 0-.437.034-.65.065c.069-.232.14-.468.254-.68c.114-.308.292-.575.469-.844c.148-.291.409-.488.601-.737c.201-.242.475-.403.692-.604c.213-.21.492-.315.714-.463c.232-.133.434-.28.65-.35l.539-.222l.474-.197l-.485-1.938l-.597.144c-.191.048-.424.104-.689.171c-.271.05-.56.187-.882.312c-.317.143-.686.238-1.028.467c-.344.218-.741.4-1.091.692c-.339.301-.748.562-1.05.944c-.33.358-.656.734-.909 1.162c-.293.408-.492.856-.702 1.299c-.19.443-.343.896-.468 1.336c-.237.882-.343 1.72-.384 2.437c-.034.718-.014 1.315.028 1.747c.015.204.043.402.063.539l.025.168l.026-.006A4.5 4.5 0 1 0 17.5 10'/%3E%3C/svg%3E");

    --icon-opacity-scale-global: {{ settings.icon_fill_opacity | divided_by: 100.0 }};
    --icon-stroke-width-scale-global: {{ icon_stroke_scale }};
  }
</style>
