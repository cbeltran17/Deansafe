<script type="application/json" data-section-ref="options_json" data-options-json>
  [
    {%- for option in product.options_with_values -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {
        "name": {{ option.name | json }},
        "position": {{ option.position | json }},
        "values": [
          {%- for option_value in option.values -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "id": {{ option_value.id | json }},
              "name": {{ option_value | json }},
              "variant_id": {{ option_value.variant.id | json }},
              "product_url": {{ option_value.product_url | json }}
            }
          {%- endfor -%}
        ]
      }
    {%- endfor -%}
  ]
</script>
