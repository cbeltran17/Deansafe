<div class="header__actions">
  {% if section.settings.hide_account_icon != true %}
    {% if customer %}
      <a
        class="header-action-btn"
        href="{{ routes.account_url }}"
        aria-label="{{ 'sections.header.account' | t }}"
      >
        <div class="header-action-btn__icon">{{ 'icon-account.svg' | inline_asset_content }}</div>
        <div class="header-action-btn__text">
          <span class="header-action-btn__title">{{ 'sections.header.dashboard' | t }}</span>
          <span>{{ 'sections.header.account' | t }}</span>
        </div>
      </a>
    {% else %}
      <a
        class="header-action-btn"
        href="{{ routes.account_login_url }}"
        aria-label="{{ 'sections.header.login' | t }}"
      >
        <div class="header-action-btn__icon">{{ 'icon-account.svg' | inline_asset_content }}</div>
        <div class="header-action-btn__text">
          <span class="header-action-btn__title">{{- 'sections.header.login' | t -}}</span>
          <span>{{ 'sections.header.account' | t }}</span>
        </div>
      </a>
    {% endif %}
  {% endif %}

  {% render 'cart-button' %}
</div>
