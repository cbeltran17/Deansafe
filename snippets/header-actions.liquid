<div class="header__actions">

  {% if section.settings.show_expert_help_header %}
    <div>
      {% render 'icon' with section.settings.show_expert_help_button_icon %}
      
      {% capture content %}
        {% render 'icon' with section.settings.action_button_icon %}
        <span>{{ section.settings.action_button_text }}</span>
      {% endcapture %}
      {% render 'button' with content,
        class: 'header__action-button',
        href: section.settings.action_button_link,
        background_color: section.settings.action_button_background_color,
        text_color: section.settings.action_button_text_color
      %}
    </div>
  {% endif %}

  {% if section.settings.hide_account_icon != true %}
    {% if customer %}
      <a
        class="header-action-btn"
        href="{{ routes.account_url }}"
        aria-label="{{ 'sections.header.account' | t }}"
      >
        <div class="header-action-btn__icon">{{ 'icon-account.svg' | inline_asset_content }}</div>
        <div class="header-action-btn__text">
          <span class="header-action-btn__title">{{ 'sections.header.dashboard' | t }}</span>
          <span>{{ 'sections.header.account' | t }}</span>
        </div>
      </a>
    {% else %}
      <a
        class="header-action-btn"
        href="{{ routes.account_login_url }}"
        aria-label="{{ 'sections.header.login' | t }}"
      >
        <div class="header-action-btn__icon">{{ 'icon-account.svg' | inline_asset_content }}</div>
        <div class="header-action-btn__text">
          <span class="header-action-btn__title">{{- 'sections.header.login' | t -}}</span>
          <span>{{ 'sections.header.account' | t }}</span>
        </div>
      </a>
    {% endif %}
  {% endif %}

  {% render 'cart-button' %}
</div>
