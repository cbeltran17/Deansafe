<div
  {{ attrs }}
  class="color-swatch"
  {% if option_value.available == false %}
    data-unavailable
  {% endif %}
  style="
    {%- if option_value.swatch.image -%}
      --swatch-fill: url({{ option_value.swatch.image | image_url: width: 128 }});
    {%- elsif option_value.swatch.color -%}
      --swatch-fill: {{ option_value.swatch.color }};
    {%- else -%}
      --swatch-fill: {% render 'get-legacy-color-swatch', option_name: option.name, option_value_name: option_value.name %};
    {%- endif -%}
  "
>
  <input
    type="radio"
    id="{{ id }}-{{ index }}"
    name="{{ id }}[{{ option.name | escape }}]"
    value="{{ option_value | escape }}"
    data-product-url="{{ option_value.product_url }}"
    data-variant-id="{{ option_value.variant.id }}"
    data-option-value-id="{{ option_value.id }}"
    {% if checked or checked != false and option_value.selected %}
      checked
    {% endif %}
  >
  <label
    class="color-swatch__label"
    for="{{ id }}-{{ index }}"
  >
    <span class="sr-only">{{ option_value }}</span>
    {% if option_value.available == false %}
      <span class="sr-only">{{ 'products.product.sold_out' | t }}</span>
      {% render 'svg-diagonal-line' %}
    {% endif %}
  </label>
</div>
