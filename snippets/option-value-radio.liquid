{% liquid
  assign is_color_option = false
  assign downcased_option_name = option.name | downcase
  
  if downcased_option_name == 'color' or downcased_option_name == 'hardware color'
    assign is_color_option = true
    assign value_name = option_value.name | default: option_value
    
    assign file_name = value_name | handleize | append: '.png'
    assign swatch_image_url = file_name | file_url
    assign fallback_color = value_name | downcase | replace: ' ', ''
  endif

  assign extra_price_text = ""
  if downcased_option_name == 'color' and option_value.variant
    if option_value.variant.price > product.price
      assign price_diff = option_value.variant.price | minus: product.price
      assign formatted_diff = price_diff | money_without_trailing_zeros
      assign extra_price_text = " + " | append: formatted_diff
    endif
  endif
%}

<div
  class="option-value-radio {% if is_color_option %}option-value-radio--color{% endif %}"
  {% if option_value.available == false %}
    data-unavailable
  {% endif %}
>
  <input
    type="radio"
    id="{{ id }}-{{ index }}"
    name="{{ id }}[{{ option.name | escape }}]"
    value="{{ option_value | escape }}"
    data-product-url="{{ option_value.product_url }}"
    data-variant-id="{{ option_value.variant.id }}"
    data-option-value-id="{{ option_value.id }}"
    data-display-value="{{ option_value | escape }}{{ extra_price_text }}"
    {% if option_value.selected %}
      checked
    {% endif %}
  >
  <label for="{{ id }}-{{ index }}" title="{{ option_value }}{{ extra_price_text }}">
    {% if is_color_option %}
      <span 
        class="radio-swatch-image" 
        style="background-image: url('{{ swatch_image_url }}'); background-color: {{ fallback_color }};"
      ></span>
      <span class="sr-only"> {{ option_value }}{{ extra_price_text }} </span>
    {% else %}
      <span> {{ option_value }}{{ extra_price_text }} </span>
    {% endif %}

    {% if option_value.available == false %}
      <span class="sr-only">{{ 'products.product.sold_out' | t }}</span>
      {% render 'svg-diagonal-line' %}
    {% endif %}
  </label>
</div>