{% liquid
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_snapchat_link == blank and settings.social_pinterest_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    break
  endif
%}

<ul
  class="social-icons social-icons--{{ size | default: 'medium' }} block-social-icons"
  role="list"
  {% if block %}
    {{ block.shopify_attributes }}
    id="shopify-block-{{ block.id }}"
  {% endif %}
>
  {%- if settings.social_facebook_link != blank -%}
    <li class="social-icons__item">
      <a
        href="{% render 'external-url', url: settings.social_facebook_link %}"
        target="_blank"
        class="social-icons__link"
        aria-label="{{ 'general.social.links.facebook' | t }}"
      >
        {{ 'icon-facebook.svg' | inline_asset_content }}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li class="social-icons__item">
      <a
        href="{% render 'external-url', url: settings.social_instagram_link %}"
        target="_blank"
        class="social-icons__link"
        aria-label="{{ 'general.social.links.instagram' | t }}"
      >
        {{ 'icon-instagram.svg' | inline_asset_content }}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
