      "max": 150,
      "step": 10,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.settings.image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.settings.image_position.options.left.label"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.settings.image_position.options.right.label"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
