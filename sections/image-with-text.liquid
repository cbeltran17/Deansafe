{% liquid
  assign lg_ratio = 200.0 | divided_by: section.settings.image_width
  capture sizes
    render 'sizes', base: 1, lg: lg_ratio
  endcapture

  if section.settings.full_width == false
    assign blend = true
  endif
%}

{% render 'section-meta', blend: blend %}

{% render 'image-size-vars',
  selector: '.media-with-text__media',
  breakpoint: 1024,
  min_width: '100%'
%}

{% capture media %}
  {% render 'image' with section.settings.image,
    image_mobile: section.settings.image_mobile,
    width: 3200,
    widths: '400, 600, 800, 1000, 1200, 1400, 1600, 2000, 2400, 3200',
    sizes: sizes,
    placeholder: true,
    animation: 'zoom-out'
  %}
{% endcapture %}

{% capture content %}
  <animation-element
    stagger="100"
    autoplay
    selector=".shopify-block"
    class="media-with-text__text-inner block-spacing"
  >
    {% content_for 'blocks' %}
  </animation-element>
{% endcapture %}

{% render 'media-with-text', media: media, content: content, section_spacing: true %}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
