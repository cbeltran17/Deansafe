{% liquid
  assign blend = true

  if section.settings.show_image
    assign image = section.settings.image | default: collection.image
  endif

  if section.settings.full_width
    assign section_size = 'full-width'
  else
    assign section_size = 'contained'
  endif

  if image
    capture sizes
      render 'sizes', full_width: section.settings.full_width, base: 1, lg: 2
    endcapture

    assign blend = false
  endif

  assign subcollections_center = false
  if image == blank
    if section.settings.text_alignment == 'center' or section.settings.text_alignment == 'two-col'
      assign subcollections_center = true
    endif
  endif

  case section.settings.description_size
    when 'small'
      assign description_size = 'prose-sm'
    when 'medium'
      assign description_size = ''
    else
      assign description_size = 'md:prose-lg'
  endcase
%}

<style>
  #shopify-section-{{ section.id }} {
    --media-with-text-ratio: {{ section.settings.image_width | divided_by: 100.0 }};
  }
</style>

{% render 'section-meta', blend: blend, blend_bg: section.settings.background_color %}
{% render 'image-size-vars',
  selector: '.media-with-text__media',
  breakpoint: 1024,
  min_height: '100%'
%}

{% capture content %}
  {% if section.settings.show_breadcrumbs %}
    {% render 'breadcrumbs' %}
  {% endif %}

  <split-text wrap class="collection-banner-title {{ section.settings.heading_size }}">
    <h1>
      {{ collection.title }}
    </h1>
  </split-text>

  {% if collection.description != blank and section.settings.show_description %}
    <div class="collection-banner-description prose {{ description_size }}">{{ collection.description }}</div>
  {% endif %}
{% endcapture %}

<animation-element
  autoplay
  animation="collection-banner"
  {% if subcollections_center %}
    data-subcollections-center
  {% endif %}
>
  {% if image != blank %}
    <div
      class="
        media-with-text
        media-with-text--media-right
        media-with-text--{{ section_size }}
      "
      {% render 'has-bg' %}
    >
      <div class="media-with-text__media">
        {% render 'image' with image,
          animation: 'zoom-out',
          width: 3840,
          widths: '360, 780, 896, 1024, 1280, 1536, 2048, 2560, 3840',
          loading: 'eager',
          fetchpriority: 'high',
          preload: true,
          sizes: sizes
        %}
      </div>
      <div class="media-with-text__text">
        <div class="media-with-text__text-inner block-spacing">
          {{ content }}
        </div>
      </div>
    </div>
  {% else %}
    {% if section.settings.show_breadcrumbs
      and section.settings.full_width == false
      and section.settings.text_alignment == 'center'
      or section.settings.text_alignment == 'two-col'
    %}
      <div class="collection-banner-breadcrumbs-outside">
        {% render 'breadcrumbs' %}
      </div>
    {% endif %}

    <div
      class="
        collection-banner-text
        collection-banner-text--{{ section.settings.text_alignment }}
        collection-banner-text--{{ section_size }}
      "
    >
      {{ content }}
    </div>
  {% endif %}
</animation-element>

