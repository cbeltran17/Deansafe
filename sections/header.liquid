<style>
  #shopify-section-{{ section.id }} .header-wrapper {
    {% render 'color-var' with section.settings.background_color, name: 'background-color' %}
    {% render 'color-var' with section.settings.text_color, name: 'text-color' %}
    --heading-color: var(--text-color);
    {% render 'color-var' with section.settings.cart_bubble_background_color, name: 'count-bubble-background' %}
    {% render 'color-var' with section.settings.cart_bubble_text_color, name: 'count-bubble-text-color' %}
    {% render 'color-var' with section.settings.search_loading_bar_color, name: 'loading-bar-color' %}
  }

  #shopify-section-{{ section.id }} .header__navigation {
    {% render 'color-var' with section.settings.navigation_background_color, name: 'background-color' %}
    {% render 'color-var' with section.settings.navigation_text_color, name: 'text-color' %}
    {%- liquid
      assign nav_bg_brightness = section.settings.navigation_background_color | color_brightness
      if nav_bg_brightness < 128
        assign item_label_duplicate_bg = section.settings.navigation_text_color | color_mix: section.settings.navigation_background_color, 10
      else
        assign item_label_duplicate_bg = section.settings.navigation_text_color | color_mix: section.settings.navigation_background_color, 6
      endif
    -%}
    {% render 'color-var' with item_label_duplicate_bg, name: 'item-label-duplicate-bg' %}
  }
</style>

{% capture mega_menu_content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% assign mega_menu_settings = mega_menu_content | split: '<mega-menu-settings>' %}

<sticky-header class="header-wrapper" mode="always">
  <size-observer height-var="header-height">
    <div class="relative">
      <div
        class="header scroll-lock-offset-co"
        data-mobile-layout="{{ section.settings.mobile_layout }}"
      >
        <button
          class="hamburger"
          data-modal="MobileMenu"
          aria-label="{{ 'accessibility.mobile_menu_button_label' | t }}"
        >
          {{ 'icon-hamburger.svg' | inline_asset_content }}
        </button>
        {% render 'header-logo' %}
        {% render 'header-search' %}
        {% render 'header-actions' %}
      </div>
      {% render 'header-search-panel' %}
    </div>
  </size-observer>
  {% render 'header-navigation', mega_menu_settings: mega_menu_settings %}
  <event-trigger
    event="search:open"
    on="click"
    class="header__search header__search--mobile"
  >
    {% render 'search-input', id: 'header-search-mobile' %}
  </event-trigger>
  <mega-menu>
    {{ mega_menu_content }}
  </mega-menu>
</sticky-header>

<backdrop-element name="header" z-index="80" hide-delay="400"></backdrop-element>

{% render 'mobile-menu', mega_menu_settings: mega_menu_settings %}
{% render 'header-search-panel-mobile' %}

