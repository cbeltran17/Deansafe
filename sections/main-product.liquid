{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<style>
  #shopify-section-{{ section.id }} {
    --product-gallery-width: {{ section.settings.product_gallery_width }}%;
  }
</style>

<product-section
  class="product-section"
  product-url="{{ product.url | within: collection | escape }}"
>
  <div class="product-breadcrumbs">
    {% render 'breadcrumbs' %}
  </div>

  <a href="#{{ section.id }}-ProductInfo" class="skip-to-content">
    {{ 'accessibility.skip_to_product_info' | t }}
  </a>

  <div class="product-layout">
    <sticky-sidebar>
      <sticky-sidebar-body>
        {% render 'product-gallery' %}
        {% render 'product-details', class: 'product-details--desktop' %}
      </sticky-sidebar-body>
    </sticky-sidebar>
    <sticky-sidebar>
      <sticky-sidebar-body>
        {% render 'product-info' %}
        {% render 'product-details', class: 'product-details--mobile' %}
      </sticky-sidebar-body>
    </sticky-sidebar>
  </div>

  {% if section.settings.sticky_add_to_cart_enabled %}
    {% render 'sticky-add-to-cart' %}
  {% endif %}
  {% render 'product-options-json' %}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-section>

{% render 'log-product-visit' %}

