{% liquid
  assign subcollections_list = section.settings.subcollections | default: collection.metafields.custom.subcollections.value
%}

{% if subcollections_list != blank %}
  {% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

  <style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>

  <div class="section-full-width section-{{ section.id }}-padding">
    {% render 'subcollections',
      collections: subcollections_list,
      alignment: section.settings.subcollections_alignment
    %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Subcollections",
  "class": "section-subcollections",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays a list of subcollections. If no list is manually selected, it will attempt to use the 'custom.subcollections' metafield on the current collection."
    },
    {
      "type": "collection_list",
      "id": "subcollections",
      "label": "Subcollections"
    },
    {
      "type": "select",
      "id": "subcollections_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Subcollections",
      "category": "Collection"
    }
  ]
}
{% endschema %}