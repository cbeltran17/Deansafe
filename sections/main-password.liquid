{% render 'section-meta' %}

<style>
  #shopify-section-{{ section.id }} {
    --password-section-logo-width: {% render 'rfs' with section.settings.logo_width, base: 180 %};
  }
</style>

{% capture shopify_svg %}
  <a
    href="//www.shopify.com"
    rel="nofollow"
    target="_blank"
    aria-label="Shopify"
  >
   {{ 'icon-shopify.svg' | inline_asset_content }}
  </a>
{% endcapture %}

<section class="password-section">
  {% render 'image',
    image: section.settings.image,
    image_mobile: section.settings.image_mobile,
    placeholder: 'lifestyle-1',
    class: 'password-section__image'
  %}
  <div class="password-section__content">
    <div class="password-section__content-inner">
      {% if settings.logo != blank %}
        {% assign logo_width_pixels = section.settings.logo_width | times: 2 %}
        {{
          settings.logo
          | image_url: width: logo_width_pixels
          | image_tag: class: 'password-section__logo'
        }}
      {% else %}
        <p class="h3">{{ shop.name }}</p>
      {% endif %}
      <div class="password-section-form">
        {% if section.settings.content != blank or shop.password_message != blank %}
          <div class="prose">
            {% if shop.password_message != blank %}
              <p>{{ shop.password_message }}</p>
            {% endif %}
            {{ section.settings.content }}
          </div>
        {% endif %}
        {% if section.settings.show_email_signup %}
          {% render 'email-signup-input', button_label: section.settings.button_text %}
        {% endif %}
        <a href="#password-enter" class="password-section__password-enter link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 15 15"
            fill="none"
          >
            <path d="M0.833313 10.1666C0.833313 8.28129 0.833313 7.33796 1.41931 6.75263C2.00465 6.16663 2.94798 6.16663 4.83331 6.16663H10.1666C12.052 6.16663 12.9953 6.16663 13.5806 6.75263C14.1666 7.33796 14.1666 8.28129 14.1666 10.1666C14.1666 12.052 14.1666 12.9953 13.5806 13.5806C12.9953 14.1666 12.052 14.1666 10.1666 14.1666H4.83331C2.94798 14.1666 2.00465 14.1666 1.41931 13.5806C0.833313 12.9953 0.833313 12.052 0.833313 10.1666Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M3.5 6.16665V4.83331C3.5 3.77245 3.92143 2.75503 4.67157 2.00489C5.42172 1.25474 6.43913 0.833313 7.5 0.833313C8.56087 0.833313 9.57828 1.25474 10.3284 2.00489C11.0786 2.75503 11.5 3.77245 11.5 4.83331V6.16665" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>{{ 'general.password_page.login_password_button' | t }}</span>
        </a>
      </div>
      <div class="password-section__footer">
        {% if section.settings.show_social_icons %}
          {% render 'social-icons' %}
        {% endif %}
        <p class="password-section__powered-by">
          {{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_svg }}
        </p>
        <p>{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </div>
  </div>
</section>

<modal-element class="password-modal" hash="password-enter">
  <div data-content>
    <div class="modal-header flex justify-between">
      <h2 class="password-modal__heading" data-title>
        {{ 'general.password_page.login_form_heading' | t }}
      </h2>
      {% render 'modal-close' %}
    </div>
    <div class="password-modal__inner">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="password-modal__errors">
            {% render 'form-errors', errors: form.errors %}
          </div>
        {%- endif -%}
        <div class="form">
          {% render 'input',
            id: 'Password',
            name: 'password',
            type: 'password',
            label_t: 'general.password_page.login_form_password_label',
            floating: true,
            required: true,
            form: form,
            form_key: 'password'
          %}
          <div class="password-modal__actions">
            {% render 'button',
              translation: 'general.password_page.login_form_submit',
              type: 'submit',
              auto_loading: true
            %}
          </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</modal-element>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.all.image_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:sections.main_password.settings.show_social_icons.label",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 480,
      "step": 20,
      "unit": "px",
      "label": "t:sections.main_password.settings.logo_width.label",
      "default": 240
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.all.content.label",
      "default": "t:sections.main_password.settings.content.default"
    },
    {
      "type": "header",
      "content": "t:sections.main_password.headers.email_signup.content"
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "t:sections.main_password.settings.show_email_signup.label",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.all.button_text.label",
      "default": "t:sections.main_password.settings.button_text.default",
      "visible_if": "{{ section.settings.show_email_signup }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.all.text_color.label"
    }
  ],
  "blocks": []
}
{% endschema %}
