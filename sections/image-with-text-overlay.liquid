{% liquid
  if section.settings.full_width == false
    assign blend = true
  endif

  capture sizes
    render 'sizes', base: 1, full_width: section.settings.full_width
  endcapture

  if section.settings.image.aspect_ratio != blank
    assign media_aspect_ratio = section.settings.image.aspect_ratio
  else
    assign media_aspect_ratio = 1
  endif
%}

{% if section.settings.image != blank %}

{% render 'section-meta', blend: blend, blend_bg: section.settings.background_color %}

<div class="section">
  {% capture media %}
    {% render 'image' with section.settings.image,
      image_mobile: section.settings.image_mobile,
      width: 3840,
      widths: '360, 780, 896, 1024, 1280, 1536, 2048, 2560, 3840',
      sizes: sizes,
      placeholder: 'lifestyle-1',
      placeholder_class: 'placeholder--dark',
      animation: 'zoom-out'
    %}
  {% endcapture %}

  {% capture content %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'media-with-overlay',
    media: media,
    content: content,
    aspect_ratio: media_aspect_ratio
  %}
</div>

{% endif %}

