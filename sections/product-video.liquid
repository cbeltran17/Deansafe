<style>
.product-video-section .product-video-wrapper {
    border-radius: 10px;
    overflow: hidden;
}

.product-video-section iframe {
    height: 700px;
}

.product-video-section .section-full-width {
    padding-top: 0;
}

@media (max-width: 768px) {
    .product-video-section iframe {
        height: 300px;
    }
}

</style> 

{% if product.metafields.custom.youtube_video != blank %}
    <section class="product-video-section">
        <div class="section-full-width">
            <div class="product-video-wrapper">
            {% assign video_value = product.metafields.custom.youtube_video.value %}

            {% if video_value contains '<iframe' %}
                {{ video_value }}
            {% else %}
                {% assign video_id = video_value
                | replace: 'https://www.youtube.com/watch?v=', ''
                | replace: 'https://youtu.be/', ''
                | split: '&'
                | first
                %}

                <iframe
                width="100%"
                height="700"
                src="https://www.youtube.com/embed/{{ video_id }}"
                title="Product Video"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
                </iframe>
            {% endif %}
            </div>
        </div>
    </section>
{% endif %}

{% schema %}
{
  "name": "Product Video",
  "presets": [
    {
      "name": "Product Video"
    }
  ]
}
{% endschema %}