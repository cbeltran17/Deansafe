{% if product.metafields.custom.youtube_video != blank %}
    <div class="section-full-width">
        <section class="product-video-section">
            <div class="product-video-wrapper">
            {% assign video_value = product.metafields.custom.youtube_video.value %}

            {% if video_value contains '<iframe' %}
                {{ video_value }}
            {% else %}
                {% assign video_id = video_value
                | replace: 'https://www.youtube.com/watch?v=', ''
                | replace: 'https://youtu.be/', ''
                | split: '&'
                | first
                %}

                <iframe
                width="100%"
                height="500"
                src="https://www.youtube.com/embed/{{ video_id }}"
                title="Product Video"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
                </iframe>
            {% endif %}
            </div>
        </section>
    </div>
{% endif %}

{% schema %}
{
  "name": "Product Video",
  "presets": [
    {
      "name": "Product Video"
    }
  ]
}
{% endschema %}