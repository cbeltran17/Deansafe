{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<style>
  #shopify-section-{{ section.id }} .collapsible-content__icon {
    {% render 'color-var' with section.settings.icon_color name: 'icon-color' %}
  }
</style>

<animation-element autoplay class="collapsible-content">
  <div class="collapsible-content__info">
    {% if section.settings.icon != blank %}
      <div class="collapsible-content__icon">
        {% render 'icon' with section.settings.icon %}
      </div>
    {% endif %}
    <div>
      {% render 'heading' %}
      {% if section.settings.description != blank %}
        <div class="collapsible-content__description prose">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
  <div class="collapsible-content__content">
    {% for block in section.blocks %}
      <smooth-collapse
        class="collapsible-content-item"
        {{ block.shopify_attributes }}
        {% if block.settings.open %}
          open
        {% endif %}
      >
        <button slot="summary" class="collapsible-content-item__summary icon-rotate">
          <p>{{ block.settings.title }}</p>
          {{ 'icon-plus.svg' | inline_asset_content }}
        </button>
        {% liquid
          assign content_html = block.settings.content
          if block.settings.content_from_page.content != blank
            assign content_html = block.settings.content_from_page.content
          endif
        %}
        <div class="collapsible-content-item__content prose">{{ content_html }}</div>
      </smooth-collapse>
    {% endfor %}
  </div>
</animation-element>

{% if request.visual_preview_mode %}
  <div class="sr-only">Filler</div>
{% endif %}

{% if section.settings.enable_structured_data %}
  {% liquid
    assign faq_count = 0
    assign faq_items = ''
  %}
  {% for block in section.blocks %}
    {% liquid
      assign answer_html = block.settings.content
      if block.settings.content_from_page != blank and block.settings.content_from_page.content != blank
        assign answer_html = block.settings.content_from_page.content
      endif
    %}
    {% if block.settings.title != blank and answer_html != blank %}
      {% capture faq_items %}
        {{ faq_items }}{% if faq_count > 0 %},{% endif %}
        {
          "@type": "Question",
          "name": {{ block.settings.title | strip_html | strip_newlines | strip | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ answer_html | strip_html | strip_newlines | strip | json }} }
        }
      {% endcapture %}
      {% assign faq_count = faq_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if faq_count > 0 %}
    <script type="application/x-faq-ld+json" data-faq>
      {{ faq_items | strip }}
    </script>
  {% endif %}
{% endif %}

