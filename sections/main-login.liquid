{% render 'section-meta' %}

{% comment %} Account recovery modal {% endcomment %}
<modal-element class="recover-account-modal" hash="recover" mobile-strategy="default">
  <div class="recover-account-modal__content">
    <div class="account-form" data-content>
      <p class="account-form__heading" data-title>
        {{ 'customer.recover_password.title' | t }}
      </p>

      <p class="account-form__text">
        {{ 'customer.recover_password.subtext' | t }}
      </p>

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}

        {%- if form.errors -%}
          <div class="account-form__errors">
            {% render 'form-errors', errors: form.errors %}
          </div>
        {%- endif -%}

        <div class="form">
          {% render 'input',
            id: 'RecoverEmail',
            name: 'email',
            type: 'email',
            label_t: 'customer.login_page.email',
            floating: true,
            required: true,
            autocomplete: 'email',
            form: form,
            form_key: 'email'
          %}
        </div>

        <div class="account-form__actions">
          {% render 'button',
            translation: 'customer.login_page.submit',
            type: 'submit',
            auto_loading: true
          %}
        </div>

        <div class="account-form__links">
          <button type="button" class="link-text" data-close>
            {{ 'customer.login_page.cancel' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</modal-element>

<div class="account-section">
  {% comment %} Login form {% endcomment %}
  <div class="account-form">
    <h1 class="account-form__heading">
      {{ 'customer.login_page.title' | t }}
    </h1>

    {%- if recover_success == true -%}
      <div role="alert" class="alert alert--success">
        {{ 'customer.recover_password.success' | t }}
      </div>
    {%- endif -%}

    {%- form 'customer_login', data-form-button-loading: true -%}
      {%- if form.errors -%}
        <div class="account-form__errors">
          {% render 'form-errors', errors: form.errors %}
        </div>
      {%- endif -%}

      <div class="form">
        {% render 'input',
          id: 'CustomerEmail',
          name: 'customer[email]',
          type: 'email',
          label_t: 'customer.login_page.email',
          floating: true,
          required: true,
          autocomplete: 'email',
          form: form,
          form_key: 'email'
        %}

        {% render 'input',
          id: 'CustomerPassword',
          name: 'customer[password]',
          type: 'password',
          label_t: 'customer.login_page.password',
          floating: true,
          required: true,
          autocomplete: 'current-password',
          form: form,
          form_key: 'password'
        %}

        <div class="account-form__actions">
          {% render 'button',
            translation: 'customer.login_page.sign_in',
            type: 'submit',
            auto_loading: true
          %}
        </div>
      </div>
    {%- endform -%}

    <div class="account-form__links">
      <a href="#recover" class="link-text">
        {{ 'customer.login_page.forgot_password' | t }}
      </a>

      <a href="{{ routes.account_register_url }}" class="link-text">
        {{ 'customer.login_page.create_account' | t }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_login.name",
  "class": "section-main-login"
}
{% endschema %}
