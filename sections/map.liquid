{% if section.settings.map_embed != blank %}
{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<div class="section-full-width">
  {% content_for 'block', type: '_section-header', id: 'section-header' %}

  <div class="map-wrapper" style="height: {{ section.settings.map_height }}px; width: 100%;">
    {{ section.settings.map_embed }}
  </div>
</div>

<style>
  /* Ensure the embedded iframe matches the wrapper container dimensions */
  #shopify-section-{{ section.id }} .map-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    border-radius: 12px;
    overflow: hidden;
  }
</style>
{% endif %}

{% schema %}
{
  "name": "Map",
  "settings": [
    {
      "type": "html",
      "id": "map_embed",
      "label": "Google Maps Embed Code",
      "info": "Go to Google Maps, search for your location, click 'Share' > 'Embed a map', and paste the iframe code here."
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 200,
      "max": 800,
      "step": 20,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing }}"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing }}"
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "presets": [
    {
      "name": "Map",
      "blocks": [
        {
          "id": "section-header",
          "static": true,
          "type": "_section-header",
          "blocks": []
        }
      ],
      "category": "Store information"
    }
  ]
}
{% endschema %}