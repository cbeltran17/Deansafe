{% liquid
  if request.page_type == 'cart'
    break
  endif

  assign has_discount_code = cart.cart_level_discount_applications | find: 'type', 'discount_code'

  if section.settings.show_checkout_button
    assign view_cart_variant = 'outline'
    assign view_cart_button_class = 'cart-drawer__view-cart button--secondary'
  endif
%}

<cart-drawer
  id="Modal-CartDrawer"
  class="cart-drawer"
  position="right"
  theme-editor-sync
  data-empty="{{ cart.empty? }}"
>
  {% if cart.empty? %}
    <div class="cart-drawer__content">
      {% render 'modal-close', floating: true %}
      <div class="cart-drawer__main cart-drawer__main--empty">
        {% render 'cart-drawer-empty' %}
      </div>
    </div>
  {% else %}
    <div class="cart-drawer__content">
      <form is="cart-form" class="cart-drawer__scroll" data-drag-close-container>
        <div class="modal-header" data-section-ref="header">
          <div data-content>
            <div class="cart-drawer-header">
              {% render 'heading', translation: 'sections.cart.title', size: 'h4', attrs: 'data-title' %}
              <span class="cart-item-count">
                {{ 'sections.cart.item_count' | t: count: cart.item_count }}
              </span>
              <button type="button" data-close class="cart-drawer-header__close">
                {{ 'icon-times.svg' | inline_asset_content }}
              </button>
            </div>
            {% if settings.enable_free_shipping_bar %}
              {% render 'free-shipping-bar' %}
            {% endif %}
          </div>
        </div>
        <div class="cart-drawer__main" data-section-ref="main">
          <div class="cart-drawer__item-list" data-content>
            {% for item in cart.items %}
              {% render 'cart-drawer-item', item: item %}
            {% endfor %}
          </div>

          {% if section.settings.product_recommendations != empty %}
            <div data-content class="cart-drawer-recommendations" data-morph-replace>
              {% render 'cart-drawer-recommendations' %}
            </div>
          {% endif %}
        </div>
      </form>
      <div class="modal-footer cart-drawer__footer">
        {% if section.settings.show_discount_code_button
          or section.settings.show_order_note
          or section.settings.show_shipping_estimator
        %}
          <div class="cart-drawer-actions" data-content data-section-ref="actions">
            {% if section.settings.show_discount_code_button %}
              <button class="cart-drawer-actions__button" data-modal="CartDrawer-DiscountCodeModal">
                {% if has_discount_code %}
                  <div class="cart-drawer-actions__indicator"></div>
                {% endif %}
                <span>{{ 'sections.cart.discount_code' | t }}</span>
                {{ 'icon-chevron-right.svg' | inline_asset_content }}
              </button>
            {% endif %}
            {% if section.settings.show_order_note %}
              <button class="cart-drawer-actions__button" data-modal="CartDrawer-OrderNoteModal">
                {% if cart.note != blank %}
                  <div class="cart-drawer-actions__indicator"></div>
                {% endif %}
                <span>{{ 'sections.cart.note' | t }}</span>
                {{ 'icon-chevron-right.svg' | inline_asset_content }}
              </button>
            {% endif %}
            {% if section.settings.show_shipping_estimator %}
              <button
                class="cart-drawer-actions__button"
                data-modal="CartDrawer-ShippingEstimatorModal"
              >
                <span>{{ 'sections.shipping_estimator.estimate_shipping' | t }}</span>
                {{ 'icon-chevron-right.svg' | inline_asset_content }}
              </button>
            {% endif %}
          </div>
        {% endif %}

        {% render 'cart-summary-total-list',
          attrs: 'data-content data-section-ref="totals"',
          show_total_discount: section.settings.show_total_discount,
          show_tax_and_shipping: section.settings.show_tax_and_shipping,
          has_discounts_enabled: section.settings.show_discount_code_button
        %}

        {% if section.settings.show_view_cart_button or section.settings.show_checkout_button %}
          <div class="cart-drawer-checkout" data-content>
            {% if section.settings.show_view_cart_button %}
              {% render 'button',
                translation: 'sections.cart.view_cart',
                class: view_cart_button_class,
                variant: view_cart_variant,
                href: routes.cart_url,
                background_color: section.settings.view_cart_button_background,
                text_color: section.settings.view_cart_button_text
              %}
            {% endif %}
            {% if section.settings.show_checkout_button %}
              {% form 'cart', cart, class: 'contents' %}
                {% capture checkout_content %}
                  {{ 'icon-padlock.svg' | inline_asset_content }}
                  {{ 'sections.cart.checkout' | t }}
                {% endcapture %}
                {% render 'button' with checkout_content,
                  class: 'cart-drawer__checkout',
                  name: 'checkout',
                  type: 'submit',
                  variant: 'flip',
                  background_color: section.settings.checkout_button_background,
                  text_color: section.settings.checkout_button_text
                %}
              {% endform %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    {% if section.settings.show_order_note %}
      {% render 'order-note-drawer' %}
    {% endif %}
    {% if section.settings.show_discount_code_button %}
      {% render 'discount-code-drawer' %}
    {% endif %}
    {% if section.settings.show_shipping_estimator %}
      {% render 'shipping-estimator-drawer' %}
    {% endif %}
  {% endif %}
</cart-drawer>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "t:sections.cart_drawer.settings.show_view_cart_button.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "t:sections.cart_drawer.settings.show_checkout_button.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_total_discount",
      "label": "t:sections.cart_drawer.settings.show_total_discount.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_and_shipping",
      "label": "t:sections.cart_drawer.settings.show_tax_and_shipping.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount_code_button",
      "label": "t:sections.cart_drawer.settings.show_discount_code_button.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "t:sections.cart_drawer.settings.show_order_note.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "t:sections.cart_drawer.settings.show_shipping_estimator.label",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.paragraph__0.content"
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.headers.cart_recommendations.content"
    },
    {
      "type": "product_list",
      "id": "product_recommendations",
      "label": "t:sections.cart_drawer.settings.product_recommendations.label"
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "t:sections.cart_drawer.settings.product_recommendations_heading.label",
      "default": "t:sections.cart_drawer.settings.product_recommendations_heading.default"
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.headers.empty_cart.content"
    },
    {
      "type": "text",
      "id": "empty_cart_heading",
      "label": "t:sections.cart_drawer.settings.empty_cart_heading.label",
      "default": "t:sections.cart_drawer.settings.empty_cart_heading.default"
    },
    {
      "type": "richtext",
      "id": "empty_cart_message",
      "label": "t:sections.cart_drawer.settings.empty_cart_message.label"
    },
    {
      "type": "collection_list",
      "id": "empty_cart_collections",
      "label": "t:sections.cart_drawer.settings.empty_cart_collections.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "view_cart_button_background",
      "label": "t:sections.cart_drawer.settings.view_cart_button_background.label",
      "visible_if": "{{ section.settings.show_view_cart_button == true }}"
    },
    {
      "type": "color",
      "id": "view_cart_button_text",
      "label": "t:sections.cart_drawer.settings.view_cart_button_text.label",
      "visible_if": "{{ section.settings.show_view_cart_button == true }}"
    },
    {
      "type": "color",
      "id": "checkout_button_background",
      "label": "t:sections.cart_drawer.settings.checkout_button_background.label",
      "visible_if": "{{ section.settings.show_checkout_button == true }}"
    },
    {
      "type": "color",
      "id": "checkout_button_text",
      "label": "t:sections.cart_drawer.settings.checkout_button_text.label",
      "visible_if": "{{ section.settings.show_checkout_button == true }}"
    }
  ]
}
{% endschema %}
