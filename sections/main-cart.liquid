<style>
  #shopify-section-{{ section.id }} .cart-title {
    {% render 'color-var' with section.settings.heading_color, name: 'heading-color' %}
  }
</style>

{% render 'section-meta' %}

<cart-section class="px-co pb-section-bottom pt-section-top" data-empty="{{ cart.empty? }}">
  {% if cart.empty? %}
    <div class="cart-empty">
      <p class="cart-empty__message">{{ 'sections.cart.empty' | t }}</p>
      {% render 'button', translation: 'general.continue_shopping', href: routes.root_url %}
    </div>
  {% else %}
    <div class="cart-header">
      <div class="cart-header__container" data-alignment="{{ section.settings.heading_alignment }}">
        <div class="cart-header__title-section">
          {% render 'heading', translation: 'sections.cart.title', class: 'cart-title' %}
          {% if section.settings.show_item_count %}
            <span class="cart-item-count" data-section-ref="item-count">
              {{ 'sections.cart.item_count' | t: count: cart.item_count }}
            </span>
          {% endif %}
        </div>
        <a href="{{ routes.root_url }}" class="cart-continue-shopping">
          {{ 'icon-chevron-left.svg' | inline_asset_content }}
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    </div>

    <div class="cart-layout">
      <div class="cart-layout__items">
        <form is="cart-form">
          {% render 'cart-table', show_vendor: section.settings.show_vendor %}
        </form>
        {% if section.settings.show_shipping_estimator
          or section.settings.show_discount_code_form
        %}
          <div class="cart-collapsible-section-container">
            {% if section.settings.show_shipping_estimator %}
              <smooth-collapse class="cart-collapsible-section">
                <button
                  slot="summary"
                  class="cart-collapsible-section__summary"
                >
                  {{ 'icon-cart-estimate-shipping.svg' | inline_asset_content }}
                  <p class="cart-collapsible-section__title">
                    {{ 'sections.cart.estimate_shipping' | t }}
                  </p>
                  <div class="cart-collapsible-section__spacer"></div>
                  {{ 'icon-chevron-down.svg' | inline_asset_content }}
                </button>
                <div class="cart-collapsible-section__content">
                  {% render 'shipping-estimator' %}
                </div>
              </smooth-collapse>
            {% endif %}
            {% if section.settings.show_discount_code_form %}
              <smooth-collapse class="cart-collapsible-section">
                <button
                  slot="summary"
                  class="cart-collapsible-section__summary"
                >
                  {{ 'icon-cart-discounts.svg' | inline_asset_content }}
                  <p class="cart-collapsible-section__title">
                    {{ 'sections.cart.discount_code' | t }}
                  </p>
                  <div class="cart-collapsible-section__spacer"></div>
                  {{ 'icon-chevron-down.svg' | inline_asset_content }}
                </button>
                <div class="cart-collapsible-section__content">
                  {% render 'discount-code' %}
                </div>
              </smooth-collapse>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <div class="cart-layout__summary">
        {% render 'cart-summary', has_discounts_enabled: section.settings.show_discount_code_form %}
      </div>
    </div>
  {% endif %}
</cart-section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_cart.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.main_cart.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_item_count",
      "label": "t:sections.main_cart.settings.show_item_count.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount_code_form",
      "label": "t:sections.main_cart.settings.show_discount_code_form.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "t:sections.main_cart.settings.show_shipping_estimator.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options.3x-large"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options.2x-large"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options.x-large"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options.large"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options.medium"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options.small"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options.x-small"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.all.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.main_cart.settings.heading_alignment.options.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.main_cart.settings.heading_alignment.options.center.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.seo"
    },
    {
      "type": "select",
      "id": "heading_seo_tag",
      "label": "t:sections.all.heading_seo_tag.label",
      "info": "t:sections.all.heading_seo_tag.info",
      "options": [
        {
          "value": "p",
          "label": "t:sections.all.heading_seo_tag.options.p.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_seo_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_seo_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_seo_tag.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_seo_tag.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_seo_tag.options.h5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_seo_tag.options.h6.label"
        },
        {
          "value": "span",
          "label": "t:sections.all.heading_seo_tag.options.span.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_seo_tag.options.div.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "t:sections.all.enable_custom_spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "t:sections.all.top_spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing }}"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.all.bottom_spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "free_shipping_bar",
      "name": "t:sections.main_cart.blocks.free_shipping_bar.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_cart.paragraph__0.content"
        }
      ]
    },
    {
      "type": "subtotal",
      "name": "t:sections.main_cart.blocks.subtotal.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_total_discount",
          "label": "t:sections.main_cart.blocks.subtotal.settings.show_total_discount.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_tax_and_shipping",
          "label": "t:sections.main_cart.blocks.subtotal.settings.show_tax_and_shipping.label",
          "default": true
        }
      ]
    },
    {
      "type": "cart_note",
      "name": "t:sections.main_cart.blocks.cart_note.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "t:sections.main_cart.blocks.cart_note.settings.heading.default"
        }
      ]
    },
    {
      "type": "checkout_button",
      "name": "t:sections.main_cart.blocks.checkout_button.name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.all.headers.colors"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:sections.all.background_color.label"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:sections.all.text_color.label"
        }
      ]
    }
  ]
}
{% endschema %}
