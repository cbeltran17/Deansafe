{% liquid
  if section.settings.full_width == false
    assign blend = true
  endif

  if section.settings.video.aspect_ratio != blank
    assign media_aspect_ratio = section.settings.video.aspect_ratio
  else
    assign media_aspect_ratio = 1.777
  endif
%}

{% render 'section-meta', blend: blend, blend_bg: section.settings.background_color %}

<div class="bg-background pb-section-bottom pt-section-top text-text">
  {% capture media %}
    {% render 'video-background',
      video: section.settings.video,
      host: section.settings.video_url.type,
      video_id: section.settings.video_url.id
    %}
  {% endcapture %}

  {% capture content %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'media-with-overlay',
    media: media,
    content: content,
    aspect_ratio: media_aspect_ratio
  %}
</div>

