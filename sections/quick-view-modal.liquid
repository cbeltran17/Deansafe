<quick-view-modal class="quick-view-modal" theme-editor-sync>
  {% if product != blank or request.design_mode %}
    {% liquid
      assign variant_image = product.selected_or_first_available_variant.featured_media
      assign product_url = product.url
      assign variant_url = product.selected_variant.url | default: product.url

      if collection
        assign product_url = product.url | within: collection
        assign variant_url = variant_url | within: collection
      endif
    %}
    <template>
      <product-section
        product-url="{{ product_url }}"
        class="quick-view-modal__content"
        portable
      >
        {% comment %} {% render 'modal-close', floating: true %} {% endcomment %}
        <sticky-sidebar padding="0" class="quick-view-modal__gallery-column">
          <sticky-sidebar-body>
            <media-lightbox
              open-target="[data-media-id]"
              class="quick-view-modal__gallery"
              data-section-ref="gallery"
            >
              {% if product == blank or product.media.size == 0 %}
                {% render 'image', placeholder: true %}
              {% else %}
                {% if variant_image %}
                  {% render 'product-media' with variant_image,
                    sizes: '190px',
                    decoding: 'async',
                    attrs: 'tabindex="0"'
                  %}
                {% endif %}
                {% for item in product.media %}
                  {% if item.id != variant_image.id and item.media_type == 'image' %}
                    {% render 'product-media' with item,
                      loading: 'lazy',
                      sizes: '190px',
                      decoding: 'async',
                      attrs: 'tabindex="0"'
                    %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </media-lightbox>
            <div class="quick-view-modal__gallery-mobile" data-inert-mobile>
              {% if product == blank or product.media.size == 0 %}
                {% render 'image', placeholder: true %}
              {% else %}
                {% render 'product-media-carousel',
                  product: product,
                  carousel_indicator_mobile: 'counter',
                  desktop_thumbnails: false
                %}
              {% endif %}
            </div>
          </sticky-sidebar-body>
        </sticky-sidebar>
        <div>
          <sticky-sidebar padding="0" class="quick-view-modal__sidebar">
            <sticky-sidebar-body>
              <div class="quick-view-modal__info block-spacing block-spacing--product">
                {% render 'product-blocks', quick_view_modal: true %}
              </div>
            </sticky-sidebar-body>
          </sticky-sidebar>
        </div>
        {% render 'product-options-json' %}
      </product-section>
      {% render 'modal-close', floating: true, slot: 'wrapper' %}
    </template>
  {% endif %}
</quick-view-modal>

