{% liquid
  capture sizes_primary
    render 'sizes', base: 1.5, lg: 2.5
  endcapture

  capture sizes_secondary
    render 'sizes', base: 3, lg: 5
  endcapture
%}

{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<style>
  {% if section.settings.image_size != blank %}
    #shopify-section-{{ section.id }} .media-with-text__media {
        --media-aspect-ratio: {{ section.settings.image_size }};
    }
  {% endif %}
</style>

<div class="section-full-width">
  <div
    class="
      media-with-text
      media-with-text--contained
      media-with-text--two-images
      media-with-text--media-{{ section.settings.image_position }}
      mx-0
    "
  >
    <div class="media-with-text__media">
      {% render 'image' with section.settings.image_primary,
        width: 1600,
        widths: '400, 600, 800, 1000, 1200, 1400, 1600',
        placeholder: true,
        placeholder_class: 'placeholder--dark',
        placeholder_aspect_ratio: '3/4',
        animation: 'zoom-out',
        sizes: sizes_primary
      %}

      {% render 'image' with section.settings.image_secondary,
        width: 1600,
        widths: '400, 600, 800, 1000, 1200, 1400, 1600',
        placeholder: true,
        placeholder_aspect_ratio: '3/4',
        animation: 'zoom-out',
        sizes: sizes_secondary
      %}
    </div>

    <div class="media-with-text__text">
      <animation-element
        stagger="100"
        autoplay
        selector=".shopify-block"
        class="media-with-text__text-inner block-spacing"
      >
        {% content_for 'blocks' %}
      </animation-element>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text_multiple.name",
  "class": "section-multiple-images-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_primary",
      "label": "t:sections.image_with_text_multiple.settings.image_primary.label"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "t:sections.image_with_text_multiple.settings.image_secondary.label"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:sections.all.image_size.label",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.image_size.options.original_size"
        },
        {
          "value": "2/3",
          "label": "t:sections.all.image_size.options.portrait_tall_2_3"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.image_size.options.portrait_3_4"
        },
        {
          "value": "1/1",
          "label": "t:sections.all.image_size.options.square"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.image_size.options.landscape_4_3"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.image_size.options.landscape_wide_3_2"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.image_size.options.landscape_wider_16_9"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text_multiple.settings.image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text_multiple.settings.image_position.options.left.label"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text_multiple.settings.image_position.options.right.label"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.all.text_color.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "t:sections.all.enable_custom_spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "t:sections.all.top_spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.all.bottom_spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "presets": [
    {
      "name": "t:sections.image_with_text_multiple.name",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "t:sections.image_with_text_multiple.presets.multiple_images_with_text.blocks.heading.settings.heading",
            "heading_size": "h1"
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "content": "t:sections.image_with_text_multiple.presets.multiple_images_with_text.blocks.paragraph.settings.content"
          }
        },
        {
          "type": "button"
        }
      ],
      "category": "t:sections.categories.media"
    }
  ]
}
{% endschema %}
