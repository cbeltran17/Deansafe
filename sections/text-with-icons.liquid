{% liquid
  assign columns_max = section.settings.columns_per_row | at_most: section.blocks.size
  assign columns_min = section.settings.columns_per_row_mobile

  if section.settings.enable_carousel_on_mobile
    assign wrap_on_desktop = true
    assign columns_min = columns_min | plus: 0.5
  else
    assign wrap = true
  endif
%}

{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<div
  class="
    section-full-width text-with-icons
    {% if section.settings.icon_position_mobile == 'left' %}
      text-with-icons--mobile-horizontal
    {% endif %}
    {% if section.settings.icon_position == 'left' %}
      text-with-icons--desktop-horizontal
    {% endif %}
  "
  style="
    {% render 'color-var' with section.settings.background_color, name: 'background-color' %}
    {% render 'color-var' with section.settings.text_color, name: 'text-color' %}
    {% render 'color-var' with section.settings.heading_color, name: 'heading-color' %}
    {% render 'color-var' with section.settings.icon_color, name: 'icon-color' %}
  "
>
  {% capture carousel_content %}
    {%- for block in section.blocks -%}
      <div class="text-with-icons__item" {{ block.shopify_attributes }}>
        <div class="text-with-icons__icon">
          {% if block.settings.custom_icon != blank %}
            {{ block.settings.custom_icon | image_url: width: 128 | image_tag: loading: 'lazy' }}
          {% elsif block.settings.icon_name != blank %}
            {% render 'icon', icon: block.settings.icon_name %}
          {% endif %}
        </div>
        <div class="text-with-icons__content">
          {% if block.settings.heading != blank %}
            <p class="text-with-icons__heading">{{ block.settings.heading }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="text-with-icons__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      </div>
    {%- endfor -%}
  {% endcapture %}

  {% render 'carousel',
    animation: 'fade-up',
    animation_target: '.text-with-icons__item',
    css_class: 'carousel--text-with-icons',
    columns_min: columns_min,
    columns_max: columns_max,
    wrap: wrap,
    wrap_on_desktop: wrap_on_desktop,
    content: carousel_content
  %}
</div>

