{% render 'section-meta', blend: true, blend_bg: section.settings.background_color %}

<div class="section-full-width">

  {% if section.settings.manual_products.count > 0 %}

    {% content_for 'block', type: '_section-header', id: 'section-header' %}

    {% render 'product-carousel',
      products: section.settings.manual_products
    %}

  {% else %}

    <product-recommendations
      section-id="{{ section.id }}"
      product-id="{{ product.id }}"
      limit="{{ section.settings.max_products }}"
      intent="related"
    >
      {% if recommendations.performed and recommendations.products_count > 0 %}
        {% content_for 'block', type: '_section-header', id: 'section-header' %}

        {% render 'product-carousel',
          products: recommendations.products
        %}
      {% endif %}
    </product-recommendations>

  {% endif %}

</div>

{% schema %}
{
  "name": "Related Products V2",
  "class": "section-related-products",
  "settings": [
    {
      "type": "product_list",
      "id": "manual_products",
      "label": "Manual Products"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "1.5",
          "label": "1.5"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 128,
      "step": 8,
      "default": 80,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    }
  ],
  "presets": [
    {
      "name": "Related Products V2",
      "category": "Products",
      "blocks": [
        {
          "id": "section-header",
          "static": true,
          "type": "_section-header",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "You may also like",
                "heading_size": "h2"
              }
            }
          ]
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}