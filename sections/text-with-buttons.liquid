{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<style>
  .text-with-buttons-wrapper--{{ section.id }} .text-with-buttons-inner {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  
  .text-with-buttons-wrapper--{{ section.id }} .twb-heading {
    color: {{ section.settings.heading_color }};
  }

  .text-with-buttons-wrapper--{{ section.id }} .twb-btn-secondary {
    border: 1px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }};
  }
</style>

<div class="text-with-buttons-wrapper section-full-width section-{{ section.id }}-padding text-with-buttons-wrapper--{{ section.id }}">
  <div class="text-with-buttons-inner">
    
    <div class="twb-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="twb-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="twb-text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="twb-actions">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_link }}" class="twb-btn twb-btn-primary">
          {{ section.settings.btn1_label | escape }}
        </a>
      {%- endif -%}
      
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_link }}" class="twb-btn twb-btn-secondary">
          {{ section.settings.btn2_label | escape }}
        </a>
      {%- endif -%}
    </div>
    
  </div>
</div>

<style>

  .text-with-buttons-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 40px;
    border-radius: 16px;
    gap: 30px;
  }

  .twb-content {
    flex: 1 1 500px;
  }

  .twb-heading {
    margin: 0 0 10px 0;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
  }

  .twb-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.9;
  }

  .twb-text p {
    margin: 0;
  }

  .twb-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    align-items: center;
  }

  .twb-btn {
    padding: 12px 28px;
    border-radius: 50px; /* Pill shape */
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .twb-btn:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .twb-btn-primary {
    background-color: #FFD700; /* Solid Yellow */
    color: #000000;
    border: 1px solid #FFD700;
  }

  .twb-btn-secondary {
    background-color: transparent;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .text-with-buttons-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 30px 20px;
    }
    
    .twb-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    
    .twb-btn {
      text-align: center;
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Text with Buttons",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still not sure what you need?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Talk to a real expert at one of our showrooms or over the phone. We have helped thousands of customers find the right safe.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary Button Label",
      "default": "Find your safe"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary Button Label",
      "default": "Contact an expert"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0F2614"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Outline Color",
      "default": "#f0f0f0"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Text with Buttons",
      "category": "Custom"
    }
  ]
}
{% endschema %}