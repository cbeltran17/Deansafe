{% liquid
  if section.settings.image != blank
    assign default_text = '#FFFFFF'
  endif

  capture sizes
    render 'sizes', base: 1, lg: 2.33
  endcapture
%}

{% render 'section-meta', blend: true, blend_bg: section.settings.background_color, colors: false %}

<style>
  #shopify-section-{{ section.id }} {
    {% render 'color-var' with section.settings.background_color, name: 'background-color' %}
  }

  #shopify-section-{{ section.id }} .product-bundle__image {
    {% render 'base-color-vars', default_text: default_text %}
  }
</style>

{% render 'image-size-vars', selector: '.product-bundle__image', breakpoint: 1024 %}

<product-bundle class="product-bundle">
  <div class="product-bundle__image">
    {% render 'image' with section.settings.image,
      image_mobile: section.settings.image_mobile,
      width: 2048,
      widths: '360, 780, 896, 1024, 1280, 1536, 2048',
      placeholder: true,
      animation: 'zoom-out',
      sizes: sizes
    %}
  </div>

  <form is="product-form" class="product-bundle__products">
    <div class="block-spacing product-bundle__content">
      {%- if section.settings.heading != blank -%}
        {%- render 'heading', class: 'block-heading' -%}
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="product-bundle__text block-paragraph prose">{{ section.settings.content }}</div>
      {%- endif -%}
    </div>

    <ul class="product-bundle__list">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% render 'product-bundle-item', product: block.settings.product, index: forloop.index %}
        </li>
      {% endfor %}
    </ul>

    {% render 'button' with section.settings.button_text,
      class: 'product-bundle__button',
      type: 'submit',
      attrs: 'data-part="btn-add-to-cart"',
      variant: 'flip'
    %}
  </form>
</product-bundle>

