<style>
    .ds-breadcrumb .page-width {
        max-width: 1500px;
        margin: 10px auto;
        padding: 0 24px;
    }

    @media (max-width: 768px) { 
        .ds-breadcrumb .page-width {
            padding: 0 12px;
        }
    }
</style>

<section class="ds-breadcrumb">
    <div class="page-width">
        {% render 'breadcrumbs' %}
    </div>
</section>


{% schema %}
{
  "name": "Breadcrumb",
  "settings": [
  ],
  "presets": [
    {
      "name": "Breadcrumb",
    }
  ]
}
{% endschema %}