{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="locations-section">
  <div class="section-full-width section-{{ section.id }}-padding">

    {% if section.settings.heading != blank %}
      <h2 class="locations-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="locations-wrapper">

      <div class="locations-list">
        {% for block in section.blocks %}
          <div 
            class="location-card {% if forloop.first %}active{% endif %}" 
            data-map="{{ block.settings.map_embed }}"
            {{ block.shopify_attributes }}
          >

            <h3>{{ block.settings.title }}</h3>

            <div class="location-info">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M15.817.113A.5.5 0 0 0 15.29 0L.5 5.5a.5.5 0 0 0 .057.948l4.73 1.576 1.576 4.73a.5.5 0 0 0 .948.057L16 1.01a.5.5 0 0 0-.183-.897z"/>
                </svg>
              </span>

              <p>{{ block.settings.address }}</p>
            </div>

            <div class="location-info">
              <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M3.654 1.328a.678.678 0 0 1 .737-.082l2.522 1.261c.329.165.445.57.263.882l-1.03 1.717a.678.678 0 0 0 .145.85l2.457 2.457a.678.678 0 0 0 .85.145l1.717-1.03a.678.678 0 0 1 .882.263l1.261 2.522a.678.678 0 0 1-.082.737l-1.272 1.59c-.32.4-.916.566-1.4.38-1.505-.576-3.793-1.96-5.95-4.117C3.288 8.747 1.904 6.459 1.328 4.954c-.185-.484-.02-1.08.38-1.4l1.946-1.226z"/>
                </svg>
              </span>

              <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">
                {{ block.settings.phone }}
              </a>
            </div>

          </div>
        {% endfor %}
      </div>

      <div class="locations-map">
        {% if section.blocks.first.settings.map_embed != blank %}
          <iframe
            id="location-map"
            src="{{ section.blocks.first.settings.map_embed }}"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy">
          </iframe>
        {% endif %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Locations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Locations"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Location Name",
          "default": "Simi Valley"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "2130 Ward Ave, Simi Valley, CA 93065"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number",
          "default": "805-526-5443"
        },
        {
          "type": "textarea",
          "id": "map_embed",
          "label": "Google Map Embed URL",
          "info": "Paste only the iframe src URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Locations"
    }
  ]
}
{% endschema %}

<style>
.locations-section .section-full-width {
    padding-top: 3rem;
    padding-bottom: 1rem;
}

.locations-heading {
  text-align: center;
  font-size: 40px;
  font-weight: 700;
  margin-bottom: 40px;
}

.locations-wrapper {
  display: flex;
  gap: 30px;
  align-items: stretch;
}

.locations-list {
  width: 35%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20px;
}

.location-card {
  background: #f7f7f7;
  border-radius: 12px;
  padding: 24px;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid transparent;
}

.location-card.active {
  border-color: #000;
}

.location-card:hover {
  transform: translateY(-2px);
}

.location-card h3 {
  margin: 0 0 16px;
  font-size: 24px;
  font-weight: 600;
  padding-bottom: 12px;
  border-bottom: 1px solid #ddd;
}

.location-info {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 14px;
}

.location-info p,
.location-info a {
  margin: 0;
  text-decoration: none;
  color: #222;
  line-height: 1.5;
}

.locations-map {
  width: 65%;
  min-height: 700px;
  border-radius: 14px;
  overflow: hidden;
}

.locations-map iframe {
  width: 100%;
  height: 100%;
  display: block;
}

@media screen and (max-width: 991px) {
  .locations-wrapper {
    flex-direction: column;
  }

  .locations-list,
  .locations-map {
    width: 100%;
  }

  .locations-map {
    min-height: 500px;
  }

  #location-map {
    min-height: 500px;
  }

  .locations-heading {
    font-size: 32px;
  }
}

@media screen and (max-width: 767px) {
  .locations-heading {
    font-size: 28px;
  }

  .location-card {
    padding: 20px;
  }

  .location-card h3 {
    font-size: 20px;
  }

  .locations-map {
    min-height: 400px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const cards = document.querySelectorAll('.location-card');
  const mapFrame = document.getElementById('location-map');

  cards.forEach(card => {

    card.addEventListener('click', function () {

      const mapUrl = this.dataset.map;

      if(mapUrl) {
        mapFrame.src = mapUrl;
      }

      cards.forEach(item => item.classList.remove('active'));
      this.classList.add('active');

    });

  });

});
</script>