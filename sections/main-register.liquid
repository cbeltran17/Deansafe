{% render 'section-meta' %}

<div class="account-section account-form">
  <h1 class="account-form__heading">
    {{ 'customer.register.title' | t }}
  </h1>
  {% form 'create_customer', data-form-button-loading: true %}
    {%- if form.errors -%}
      <div class="account-form__errors">
        {% render 'form-errors', errors: form.errors, form_id: 'RegisterForm' %}
      </div>
    {%- endif -%}

    <div class="form">
      {% render 'input',
        id: 'RegisterForm-FirstName',
        name: 'customer[first_name]',
        type: 'text',
        label_t: 'customer.register.first_name',
        floating: true,
        autocomplete: 'given-name',
        form: form,
        form_key: 'first_name',
        field_class: 'form-field--half'
      %}

      {% render 'input',
        id: 'RegisterForm-LastName',
        name: 'customer[last_name]',
        type: 'text',
        label_t: 'customer.register.last_name',
        floating: true,
        autocomplete: 'family-name',
        form: form,
        form_key: 'last_name',
        field_class: 'form-field--half'
      %}

      {% render 'input',
        id: 'RegisterForm-email',
        name: 'customer[email]',
        type: 'email',
        label_t: 'customer.register.email',
        floating: true,
        required: true,
        autocomplete: 'email',
        form: form,
        form_key: 'email'
      %}

      {% render 'input',
        id: 'RegisterForm-password',
        name: 'customer[password]',
        type: 'password',
        label_t: 'customer.register.password',
        floating: true,
        required: true,
        form: form,
        form_key: 'password'
      %}
    </div>

    <div class="account-form__actions">
      {% render 'button', translation: 'customer.register.submit', type: 'submit' %}
    </div>
  {% endform %}
</div>
